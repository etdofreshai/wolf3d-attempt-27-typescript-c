# Keep secrets and generated build artifacts out of git.

# Secrets and local environment
auth/
credentials/
secrets/
*.env
.env
.env.*
!.env.example

# Build and editor artifacts
/build/
.cmake/
.cache/
node_modules/
apps/*/dist/
deps/borland/*
!deps/borland/.gitkeep
.DS_Store
*.log

# generated by apps/source-typescript-3/typecheck.mjs
apps/source-typescript-3/tsconfig.typecheck.json
