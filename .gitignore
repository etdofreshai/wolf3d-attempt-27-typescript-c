# Keep secrets and generated build artifacts out of git.

# Secrets and local environment
auth/
credentials/
secrets/
*.env
.env
.env.*
!.env.example

# Build and editor artifacts
/build/
.cmake/
.cache/
node_modules/
apps/*/dist/
deps/borland/*
!deps/borland/.gitkeep
artifacts/
reports/
*.artifact-manifest.json
*.parity-report.json
.DS_Store
*.log
