{
  "name": "wolf3d-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace @wolf3d/dos-page run dev",
    "build": "npm run build --workspaces --if-present",
