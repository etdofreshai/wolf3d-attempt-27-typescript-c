{
  "name": "wolf3d-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev:launcher",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:launcher": "npm --workspace @wolf3d/launcher run dev",
    "dev:steam": "npm --workspace @wolf3d/dos-page run dev",
    "dev:source": "npm --workspace @wolf3d/source-dos run dev",
    "dev:source-modified": "npm --workspace @wolf3d/source-modified-dos run dev",
    "dev:source-typescript": "npm --workspace @wolf3d/source-typescript run dev",
    "demo:plan": "node scripts/wolf-demo-plan.mjs",
    "demo:compare": "node scripts/wolf-artifact-compare.mjs",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "preview": "npm --workspace @wolf3d/dos-page run preview",
    "preview:launcher": "npm --workspace @wolf3d/launcher run preview",
    "preview:source": "npm --workspace @wolf3d/source-dos run preview",
    "preview:source-modified": "npm --workspace @wolf3d/source-modified-dos run preview",
    "preview:source-typescript": "npm --workspace @wolf3d/source-typescript run preview"
  }
}
